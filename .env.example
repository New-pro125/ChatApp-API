NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Serve /api/openapi.json and /api/docs. Defaults to true outside production.
DOCS_ENABLED=true

# HTTP server hardening
HTTP_BODY_LIMIT_BYTES=262144
HTTP_REQUEST_TIMEOUT_MS=300000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_CONNECTIONS_CHECK_INTERVAL_MS=30000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_MAX_HEADER_SIZE_BYTES=16384
HTTP_SHUTDOWN_TIMEOUT_MS=15000
HTTP_COMPRESSION_THRESHOLD_BYTES=1024
# Prometheus metrics at /metrics. Defaults to true outside production.
METRICS_ENABLED=true
# Require "Authorization: Bearer <token>" on /metrics. Leave empty to disable auth.
METRICS_TOKEN=
HEALTH_CACHE_TTL_MS=5000
# "true" trusts one proxy hop, "false" disables it; a number or CIDR subnet also works.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API with credentials.
APP_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://app:app@localhost:5434/inversify
# Set DATABASE_URL to the PgBouncer port (6434 locally) in production.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6381

# Token authentication
# Ed25519 seed for signing access tokens. Required in production; generated
# with the command below. Development falls back to an ephemeral key, which
# invalidates tokens on every restart.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_ISSUER=inversify-messenger
ACCESS_TOKEN_AUDIENCE=inversify-messenger
# Access JWT lifetime (15 minutes) and refresh token lifetime (30 days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Single-use grant code for browser OAuth callback redirects, and the TTL of
# the Redis-backed OAuth state that the state cookie points at.
OAUTH_GRANT_TTL_SECONDS=60
OAUTH_STATE_TTL_SECONDS=600
OAUTH_STATE_COOKIE_NAME=inversify.oauth
LOG_LEVEL=debug

# Account lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900

# Password reset OTP
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESET_TOKEN_TTL_SECONDS=600

# Email verification
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Two-factor authentication (TOTP)
MFA_ENABLED=true
MFA_ISSUER=inversify-passport
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=
MFA_TOTP_WINDOW=1
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_ENROLLMENT_TTL_SECONDS=600
MFA_RECOVERY_CODE_COUNT=10

# SMTP (uncomment to send real email; Mailpit runs via `docker compose --profile tools up -d`)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com

# GitHub OAuth (enable by setting all three values)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/oauth/github/callback

# Google OAuth (enable by setting all three values)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback

# OIDC SSO (set SSO_ENABLED=true and provide the issuer settings)
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
OAUTH_FAILURE_REDIRECT=http://localhost:5173/auth/error
OAUTH_MFA_REDIRECT=http://localhost:5173/auth/mfa

SSO_ENABLED=false
# SSO_ISSUER=https://issuer.example.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_CALLBACK_URL=http://localhost:4000/api/auth/sso/callback
SSO_SCOPES=openid profile email

POSTGRES_DB=inversify
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST_PORT=5434
PGBOUNCER_HOST_PORT=6434
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25
REDIS_HOST_PORT=6381
API_HOST_PORT=4000
ADMINER_HOST_PORT=8088
REDISINSIGHT_HOST_PORT=5540
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# S3-compatible object storage (MinIO locally)
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=messenger-media
MINIO_REGION=us-east-1

# TURN relay for WebRTC voice/video calls
TURN_HOST_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
TURN_REALM=inversify.local
TURN_USER=turnuser
TURN_PASSWORD=turnpassword

# Optional antivirus sidecar (`docker compose --profile scan up -d`)
CLAMAV_HOST_PORT=3310
